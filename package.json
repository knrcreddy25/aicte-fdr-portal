{
  "name": "aicte-fdr-portal",
  "version": "1.0.0",
  "description": "AICTE Security Deposit / FDR Management Portal",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "better-sqlite3": "^11.10.0",
    "connect-sqlite3": "0.9.15",
    "csrf": "3.1.0",
    "ejs": "3.1.10",
    "express": "4.18.3",
    "express-rate-limit": "7.2.0",
    "express-session": "1.18.0",
    "helmet": "7.1.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "pdfkit": "0.14.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "bcrypt@5.1.1": true
  }
}
